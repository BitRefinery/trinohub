# Copy to automation/agent.env and edit. Do NOT commit agent.env.
# Shared by run-agent.sh (issue agent) and prepare-release.sh (release job).

# Required:
REPO=BitRefinery/trinohub

# Optional (defaults shown):
# BASE_BRANCH=main
# LOGDIR=$HOME/.trinohub-agent/logs
# CLAUDE_MODEL=claude-opus-4-8

# --- Issue agent (run-agent.sh) ---
# WORKDIR=$HOME/.trinohub-agent/checkout
# MAX_ISSUES=3
# TEST_CMD=.venv/bin/python -m unittest discover -s tests -v && .venv/bin/python testing/run_e2e.py

# --- Release job (prepare-release.sh) ---
# A SEPARATE clone from the issue agent: both jobs run on Friday.
# RELEASE_WORKDIR=$HOME/.trinohub-agent/release-checkout
# Force a specific version instead of the automatic pre-1.0 bump heuristic:
# RELEASE_VERSION=0.4.0

# --- Commit identity ---
# BitRefinery is the only GitHub identity for this project. There is deliberately
# no global git identity on the build box, so these are what the clones use.
# Overriding them will misattribute commits — leave them alone.
# GIT_AUTHOR_NAME_=BitRefinery
# GIT_AUTHOR_EMAIL_=299273308+BitRefinery@users.noreply.github.com

# If you authenticate Claude Code with an API key instead of `claude login`:
# ANTHROPIC_API_KEY=sk-ant-...
